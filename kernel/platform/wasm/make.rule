# tools
AR = emar
AS = emcc
CC = emcc
CXX = em++
LD = emcc
OBJCOPY = true  # WASM doesn't need objcopy
OBJDUMP = true  # WASM doesn't need objdump

SRC_DIR=$(EWOKOS_ROOT_DIR)/kernel

ARCH_DIR=$(SRC_DIR)/platform/wasm/arch
BSP_DIR=bsp

SYS_FULL_DIR = $(EWOKOS_ROOT_DIR)/machine/$(MACHINE)/system
BUILD_DIR = .

# WASM-specific flags
WASM_FLAGS = -s WASM=1 \
	-s EXPORTED_FUNCTIONS='["_main", "_malloc", "_free"]' \
	-s EXPORTED_RUNTIME_METHODS='["ccall", "cwrap"]' \
	-s ALLOW_MEMORY_GROWTH=1 \
	-s INITIAL_MEMORY=33554432 \
	-s STACK_SIZE=1048576 \
	-s NO_EXIT_RUNTIME=1 \
	-s ASYNCIFY=1 \
	--pre-js $(ARCH_DIR)/wasm/pre.js

# flags
ASFLAGS = $(OPTM) -I. -I$(SRC_DIR)/include $(ARCH_CFLAGS)

ifeq ($(DEBUG),yes)
OPTM = -g 
WASM_FLAGS += -g -s ASSERTIONS=1
else
OPTM = -O2
endif

CFLAGS += $(OPTM) \
	-I. -I$(SRC_DIR)/lib/include \
	-I$(SRC_DIR)/kernel/include \
	-I$(SRC_DIR)/dev/include \
	-I$(ARCH_DIR)/wasm \
	-I$(ARCH_DIR)/wasm/include \
	$(ARCH_CFLAGS) \
	-Wstrict-prototypes \
	-pedantic -Wall -Wextra \
	-fno-builtin-printf \
	-fno-builtin-strcpy \
	-Wno-overlength-strings \
	-fno-builtin-exit \
	-fno-builtin-stdio \
	-fno-builtin-memset \
	-fno-builtin-memcpy \
	-fno-builtin-strchr \
	-fno-builtin-strcmp \
	-fno-builtin-strlen \
	-fno-builtin-strncpy \
	-fno-builtin-strncmp \
	-std=gnu11

ARCH_OBJS += \
	$(ARCH_DIR)/wasm/boot.o \
	$(ARCH_DIR)/wasm/interrupt.o \
	$(ARCH_DIR)/wasm/system.o \
	$(ARCH_DIR)/wasm/mmu.o

LIB_EXT2_DIR=$(SRC_DIR)/lib/ext2
LIB_EXT2_OBJS = $(LIB_EXT2_DIR)/src/partition.o $(LIB_EXT2_DIR)/src/ext2read.o 
CFLAGS += -I$(LIB_EXT2_DIR)/include

LIB_SCONF_DIR=$(SRC_DIR)/lib/sconf
LIB_SCONF_OBJS = $(LIB_SCONF_DIR)/src/sconf.o 
CFLAGS += -I$(LIB_SCONF_DIR)/include

LIB_DIR = $(SRC_DIR)/lib/src
LIB_OBJS = \
	$(LIB_DIR)/kstring.o \
	$(LIB_DIR)/mstr.o \
	$(LIB_DIR)/atoi.o \
	$(LIB_DIR)/vprintf.o \
	$(LIB_DIR)/proto.o \
	$(LIB_DIR)/queue.o \
	$(LIB_DIR)/kprintf.o \
	$(LIB_EXT2_OBJS) \
	$(LIB_SCONF_OBJS)

LOAD_DIR=$(SRC_DIR)/loadinit/wasm
LOAD_OBJS = \
	$(LOAD_DIR)/loadinit.o

DEV_DIR = $(SRC_DIR)/dev/src

CFLAGS += -I$(LOAD_DIR)

KERNEL_DIR = $(SRC_DIR)/kernel/src
KERNEL_OBJS = \
	$(KERNEL_DIR)/mm/kalloc.o \
	$(KERNEL_DIR)/mm/trunkmem.o \
	$(KERNEL_DIR)/mm/kmalloc.o \
	$(KERNEL_DIR)/mm/kmalloc_vm.o \
	$(KERNEL_DIR)/mm/dma.o \
	$(KERNEL_DIR)/mm/shm.o \
	$(KERNEL_DIR)/mm/mmu.o \
	$(KERNEL_DIR)/smp/core.o \
	$(KERNEL_DIR)/irq.o \
	$(KERNEL_DIR)/svc.o \
	$(KERNEL_DIR)/semaphore.o \
	$(KERNEL_DIR)/proc.o \
	$(KERNEL_DIR)/ipc.o \
	$(KERNEL_DIR)/signal.o \
	$(KERNEL_DIR)/interrupt.o \
	$(KERNEL_DIR)/schedule.o \
	$(KERNEL_DIR)/system.o \
	$(KERNEL_DIR)/kevqueue.o \
	$(KERNEL_DIR)/kernel_config.o \
	$(KERNEL_DIR)/hw_info.o \
	$(KERNEL_DIR)/kernel.o

OBJS = $(ARCH_OBJS) \
	$(LIB_OBJS) \
	$(LOAD_OBJS) \
	$(KERNEL_OBJS) \
	$(DEV_OBJS) 

LDFLAGS = $(WASM_FLAGS)

all: $(OS_IMG) index.html

$(OS_IMG): $(OBJS)
	$(LD) $(OBJS) $(LDFLAGS) -o $(BUILD_DIR)/$(OS_ELF)
	cp $(BUILD_DIR)/$(OS_ELF) $(BUILD_DIR)/$(OS_IMG)

index.html: $(ARCH_DIR)/wasm/index.html
	cp $(ARCH_DIR)/wasm/index.html $(BUILD_DIR)/index.html

clean:
	rm -f $(OBJS)
	rm -f $(OS_IMG) $(OS_ELF) index.html